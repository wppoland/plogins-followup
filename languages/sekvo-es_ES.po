#. Plugin Name of the plugin
#: sekvo.php
msgid "Sekvo - Follow-Up Emails for WooCommerce"
msgstr ""

#. Plugin URI of the plugin
#: sekvo.php
msgid "https://plogins.com/sekvo/"
msgstr ""

#. Description of the plugin
#: sekvo.php
msgid ""
"Send automated post-purchase emails to WooCommerce customers: thank-you and "
"review requests, a set number of days after an order."
msgstr ""
"Envíe correos electrónicos automatizados posteriores a la compra a los "
"clientes de WooCommerce: solicitudes de agradecimiento y revisión, una "
"cantidad determinada de días después de realizar un pedido."

#. Author of the plugin
#: sekvo.php
msgid "WPPoland.com"
msgstr ""

#. Author URI of the plugin
#: sekvo.php
msgid "https://wppoland.com"
msgstr ""

