#. Plugin Name of the plugin
#: sekvo.php
msgid "Sekvo - Follow-Up Emails for WooCommerce"
msgstr "Sekvo - wiadomości posprzedażowe dla WooCommerce"

#. Plugin URI of the plugin
#: sekvo.php
msgid "https://plogins.com/sekvo/"
msgstr "https://plogins.com/sekvo/"

#. Description of the plugin
#: sekvo.php
msgid ""
"Send automated post-purchase emails to WooCommerce customers: thank-you and "
"review requests, a set number of days after an order."
msgstr ""
"Wysyłaj automatyczne wiadomości posprzedażowe do klientów WooCommerce: "
"podziękowania i prośby o opinię, określoną liczbę dni po złożeniu zamówienia."

#. Author of the plugin
#: sekvo.php
msgid "WPPoland.com"
msgstr "WPPoland.com"

