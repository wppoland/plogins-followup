msgid "https://wppoland.com"
msgstr "https://wppoland.com"

#: sekvo.php:80
msgid "Sekvo requires WooCommerce to be installed and activated."
msgstr "Sekvo wymaga zainstalowanego i aktywnego WooCommerce."

