#. Plugin Name of the plugin
#: sekvo.php
msgid "Sekvo - Follow-Up Emails for WooCommerce"
msgstr ""

#. Plugin URI of the plugin
#: sekvo.php
msgid "https://plogins.com/sekvo/"
msgstr ""

#. Description of the plugin
#: sekvo.php
msgid ""
"Send automated post-purchase emails to WooCommerce customers: thank-you and "
"review requests, a set number of days after an order."
msgstr ""
"Sende automatisierte E-Mails nach dem Kauf an WooCommerce-Kunden: "
"Dankeschön- und Bewertungsanfragen, eine festgelegte Anzahl von Tagen nach "
"einer Bestellung."

#. Author of the plugin
#: sekvo.php
msgid "WPPoland.com"
msgstr ""

#. Author URI of the plugin
#: sekvo.php
msgid "https://wppoland.com"
msgstr ""

#: sekvo.php:80
msgid "Sekvo requires WooCommerce to be installed and activated."
msgstr ""

