#. Plugin Name of the plugin
#: plogins-followup.php
msgid "Plogins Followup - Follow-Up Emails for WooCommerce"
msgstr ""

#. Plugin URI of the plugin
#: plogins-followup.php
msgid "https://plogins.com/plogins-followup/"
msgstr ""

#. Description of the plugin
#: plogins-followup.php
msgid ""
"Send automated post-purchase emails to WooCommerce customers: thank-you and "
"review requests, a set number of days after an order."
msgstr ""
"Wysyłaj automatyczne wiadomości posprzedażowe do klientów WooCommerce: "
"podziękowania i prośby o opinię, określoną liczbę dni po złożeniu zamówienia."

#. Author of the plugin
#: plogins-followup.php
msgid "WPPoland.com"
msgstr ""

#. Author URI of the plugin
#: plogins-followup.php
msgid "https://wppoland.com"
msgstr ""

#: plogins-followup.php:79
msgid ""
"Followup - Order Follow-Up Emails for WooCommerce requires WooCommerce to be "
"active."
msgstr ""
"Followup - Wiadomości posprzedażowe dla WooCommerce wymaga aktywnej wtyczki "
"WooCommerce."

